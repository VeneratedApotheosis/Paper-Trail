# Copy to .env.local and fill in. Never commit real values.

# SQLite database file (dev/demo)
DATABASE_URL=./papertrail.sqlite

# Gmail OAuth (added in issue #2; scope is gmail.readonly only)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LLM provider key (extraction/wording only; numbers come from deterministic rules)
LLM_API_KEY=your-llm-api-key
