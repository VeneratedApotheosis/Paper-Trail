# Copy to .env.local and fill in. Never commit real values.

# SQLite database file (dev/demo)
DATABASE_URL=./papertrail.sqlite

# Gmail OAuth (added in issue #2; scope is gmail.readonly only)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LLM provider key (extraction/wording only; numbers come from deterministic rules)
ANTHROPIC_API_KEY=your-anthropic-api-key
# Anthropic model used for extraction (optional; this is the default)
LLM_MODEL=claude-haiku-5-5

# OAuth encryption key: generate locally with openssl rand -hex 32; keep stable and private.
AUTH_ENCRYPTION_KEY=replace-with-64-hex-characters
# Exact app origin; must match the Google OAuth client's registered callback origin.
AUTH_BASE_URL=http://localhost:3000
